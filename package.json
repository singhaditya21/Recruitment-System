{
  "name": "recruitment-system-wireframe",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:artifacts": "node scripts/audit-artifacts.mjs",
    "audit:interactions": "node scripts/audit-interactions.mjs",
    "record:business-case-01": "node scripts/record-business-case-01.mjs",
    "record:business-case-01:v2": "node scripts/record-business-case-01.mjs",
    "package:business-case-01:v2": "node scripts/package-business-case-01-cuts.mjs",
    "record:business-case-library": "node scripts/record-business-case-library.mjs",
    "validate:business-case-library": "node scripts/record-business-case-library.mjs --validate-only",
    "validate:business-case-media": "node scripts/validate-business-case-library.mjs --full-decode",
    "verify": "pnpm audit:artifacts && pnpm audit:interactions && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
