  "rules": [
    { "id": "AUT-001", "name": "Application confirmation", "trigger": "TRN-001 succeeds", "action": "queue confirmation and recruiter work", "guard": "current submission version", "idempotency": "applicationId:submissionVersion:confirmation", "cancel": "superseded submission" },
